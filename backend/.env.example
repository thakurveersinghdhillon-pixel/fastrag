# FastRAG Application Settings
# Copy this file to .env and adjust variables as needed for local development.

APP_NAME=FastRAG
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# LLM Generation & Provider Settings
# -----------------------------------------------------------------------------
# LLM Provider: 'openai' (compatible with OpenAI, Gemini, LocalAI, vLLM, Ollama) or 'mock'
FASTRAG_LLM_PROVIDER=openai

# LLM Model Name
# Examples:
#   - Gemini: gemini-3.8-flash
#   - OpenAI: gpt-4o-mini
FASTRAG_LLM_MODEL=gemini-3.8-flash

# Base URL for OpenAI-compatible endpoint (plain URL without trailing slash or markdown brackets)
# Examples:
#   - Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   - OpenAI: https://api.openai.com/v1
FASTRAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# API Key for Hosted LLM Provider (NEVER commit your actual API key to source control)
FASTRAG_LLM_API_KEY=your_api_key_here

# Generation Parameters
FASTRAG_LLM_TEMPERATURE=0.0
FASTRAG_LLM_MAX_TOKENS=1024
FASTRAG_LLM_TIMEOUT_SECONDS=30.0
FASTRAG_LLM_STREAMING=true

# -----------------------------------------------------------------------------
# Caching Settings (Phase 8)
# -----------------------------------------------------------------------------
# Tier 2 Query Embedding Vector Cache (avoids redundant transformer forward passes)
FASTRAG_ENABLE_EMBEDDING_CACHE=true
FASTRAG_EMBEDDING_CACHE_SIZE=10000

# Tier 1 Grounded Query Response Cache (bypasses retrieval & generation for identical queries)
FASTRAG_ENABLE_QUERY_CACHE=true
FASTRAG_QUERY_CACHE_SIZE=2000
FASTRAG_QUERY_CACHE_TTL_SECONDS=3600.0

